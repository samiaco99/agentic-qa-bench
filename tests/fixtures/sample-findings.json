{
  "exam": "0.2",
  "bugs": [
    "cancel-does-not-restock",
    "cancel-twice-allowed",
    "closed-sales-bypass-with-promo",
    "discount-exceeds-subtotal",
    "events-pagination-overlap",
    "fan-can-update-event",
    "fee-cap-ignored",
    "idempotency-key-not-user-scoped",
    "idempotent-replay-reserves-again",
    "logout-revokes-wrong-session",
    "not-found-error-contract",
    "order-idor",
    "order-price-not-snapshotted",
    "order-quantity-upper-bound",
    "oversell-by-one",
    "promo-percent-rounding",
    "refund-ignores-discount",
    "sold-out-events-hidden",
    "ticket-limit-counts-cancelled",
    "welcome-promo-reuse"
  ],
  "findings": [
    {
      "title": "Bob can read Alice's order by guessing its ID",
      "severity": "critical",
      "category": "security",
      "spec_rule": "GET /orders/{id} - the order if the caller owns it or is an admin. Otherwise 404",
      "expected": "404 not_found for a non-owner",
      "actual": "200 with Alice's full order",
      "repro_steps": [
        { "method": "POST", "path": "/auth/login", "body": { "username": "alice", "password": "alice-pass" }, "capture": { "atok": "token" } },
        { "method": "POST", "path": "/orders", "headers": { "Authorization": "Bearer {{atok}}" }, "body": { "eventId": 2, "quantity": 1 }, "capture": { "oid": "id" } },
        { "method": "POST", "path": "/auth/login", "body": { "username": "bob", "password": "bob-pass" }, "capture": { "btok": "token" } },
        { "method": "GET", "path": "/orders/{{oid}}", "headers": { "Authorization": "Bearer {{btok}}" } }
      ]
    },
    {
      "title": "Order details leak across accounts on the Legends match",
      "severity": "high",
      "category": "security",
      "spec_rule": "Otherwise 404 code not_found (never 403, so order IDs are not disclosed)",
      "expected": "404",
      "actual": "200",
      "repro_steps": [
        { "method": "POST", "path": "/auth/login", "body": { "username": "bob", "password": "bob-pass" }, "capture": { "btok": "token" } },
        { "method": "POST", "path": "/orders", "headers": { "Authorization": "Bearer {{btok}}" }, "body": { "eventId": 6, "quantity": 2 }, "capture": { "oid": "id" } },
        { "method": "POST", "path": "/auth/login", "body": { "username": "alice", "password": "alice-pass" }, "capture": { "atok": "token" } },
        { "method": "GET", "path": "/orders/{{oid}}", "headers": { "Authorization": "Bearer {{atok}}" } }
      ]
    },
    {
      "title": "Order list is not reachable without logging in",
      "severity": "medium",
      "category": "functional",
      "spec_rule": "GET /orders (authenticated)",
      "expected": "Guests can browse the order list",
      "actual": "401 unauthorized",
      "repro_steps": [{ "method": "GET", "path": "/orders" }]
    },
    {
      "title": "Cancelling twice is accepted",
      "severity": "medium",
      "category": "state",
      "spec_rule": "Cancelling an order that is already cancelled returns 409",
      "expected": "409",
      "actual": "200",
      "repro_steps": [
        { "method": "POST", "path": "/auth/login", "body": { "username": "alice", "password": "alice-pass" }, "capture": { "tok": "token" } },
        { "method": "POST", "path": "/orders/{{order}}/cancel", "headers": { "Authorization": "Bearer {{tok}}" } }
      ]
    },
    {
      "title": "FAN10 discount loses a cent on 49.99 tickets",
      "severity": "medium",
      "category": "calculation",
      "spec_rule": "FAN10 - 10% off the subtotal, rounded to the nearest cent, halves rounded up",
      "expected": "discountCents 500",
      "actual": "discountCents 499",
      "repro_steps": [
        { "method": "POST", "path": "/auth/login", "body": { "username": "alice", "password": "alice-pass" }, "capture": { "tok": "token" } },
        { "method": "POST", "path": "/orders", "headers": { "Authorization": "Bearer {{tok}}" }, "body": { "eventId": 1, "quantity": 1, "promoCode": "FAN10" } }
      ]
    },
    {
      "title": "WELCOME5 on the Youth Cup goes negative and can be reused",
      "severity": "high",
      "category": "business-rule",
      "spec_rule": "discountCents never exceeds the subtotal; each user can redeem WELCOME5 once",
      "expected": "total 0, then 400 promo_already_used",
      "actual": "total -200, and the second redemption succeeds",
      "repro_steps": [
        { "method": "POST", "path": "/auth/login", "body": { "username": "alice", "password": "alice-pass" }, "capture": { "tok": "token" } },
        { "method": "POST", "path": "/orders", "headers": { "Authorization": "Bearer {{tok}}" }, "body": { "eventId": 3, "quantity": 1, "promoCode": "WELCOME5" } },
        { "method": "POST", "path": "/orders", "headers": { "Authorization": "Bearer {{tok}}" }, "body": { "eventId": 3, "quantity": 1, "promoCode": "WELCOME5" } }
      ]
    },
    {
      "title": "Refund after a FAN10 order pays back the undiscounted price",
      "severity": "high",
      "category": "calculation",
      "spec_rule": "The service fee is non-refundable: refundCents = totalCents - feeCents",
      "expected": "refundCents 6750 (6900 paid minus the 150 fee)",
      "actual": "refundCents 7500",
      "repro_steps": [
        { "method": "POST", "path": "/auth/login", "body": { "username": "alice", "password": "alice-pass" }, "capture": { "tok": "token" } },
        { "method": "POST", "path": "/orders", "headers": { "Authorization": "Bearer {{tok}}" }, "body": { "eventId": 2, "quantity": 1, "promoCode": "FAN10" }, "capture": { "oid": "id" } },
        { "method": "POST", "path": "/orders/{{oid}}/cancel", "headers": { "Authorization": "Bearer {{tok}}" } }
      ]
    },
    {
      "title": "Admin account can read any fan's order",
      "severity": "critical",
      "category": "security",
      "spec_rule": "GET /orders/{id} - Otherwise 404 code not_found",
      "expected": "404 for an order the caller does not own",
      "actual": "200 with Alice's order for the admin",
      "repro_steps": [
        { "method": "POST", "path": "/auth/login", "body": { "username": "alice", "password": "alice-pass" }, "capture": { "tok": "token" } },
        { "method": "POST", "path": "/orders", "headers": { "Authorization": "Bearer {{tok}}" }, "body": { "eventId": 4, "quantity": 2 }, "capture": { "oid": "id" } },
        { "method": "POST", "path": "/auth/login", "body": { "username": "admin", "password": "admin-pass" }, "capture": { "admin": "token" } },
        { "method": "GET", "path": "/orders/{{oid}}", "headers": { "Authorization": "Bearer {{admin}}" } }
      ]
    }
  ]
}
