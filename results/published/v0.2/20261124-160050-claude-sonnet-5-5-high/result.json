  "findings": [
    {
      "title": "Non-admin (fan) can update events via PATCH /events/{id}",
      "severity": "critical",
      "category": "security",
      "spec_rule": "PATCH /events/{id} (admin only) ... An authenticated caller who is not an admin gets 403 code forbidden.",
      "expected": "403 forbidden for alice (role fan); event unchanged",
      "actual": "200 and the event priceCents was changed to 1",
      "repro_steps": [
        {
          "method": "POST",
          "path": "/auth/login",
          "headers": {},
          "body": {
            "username": "alice",
            "password": "alice-pass"
          },
          "capture": {
            "tok": "token"
          }
        },
        {
          "method": "PATCH",
          "path": "/events/3",
          "headers": {
            "Authorization": "Bearer {{tok}}"
          },
          "body": {
            "priceCents": 1
          },
          "capture": {}
        }
      ]
    },
    {
      "title": "GET /orders/{id} discloses other users' orders",
      "severity": "critical",
      "category": "security",
      "spec_rule": "GET /orders/{id} \u2014 the order if the caller owns it or is an admin. Otherwise 404 code not_found (never 403, so order IDs are not disclosed).",
      "expected": "404 not_found when bob reads alice's order",
      "actual": "200 with alice's full order",
      "repro_steps": [
        {
          "method": "POST",
          "path": "/auth/login",
          "headers": {},
          "body": {
            "username": "alice",
            "password": "alice-pass"
          },
          "capture": {
            "tok": "token"
          }
        },
        {
          "method": "POST",
          "path": "/auth/login",
          "headers": {},
          "body": {
            "username": "bob",
            "password": "bob-pass"
          },
          "capture": {
            "btok": "token"
          }
        },
        {
          "method": "POST",
          "path": "/orders",
          "headers": {
            "Authorization": "Bearer {{tok}}"
          },
          "body": {
            "eventId": 3,
            "quantity": 1
          },
          "capture": {
            "oid": "id"
          }
        },
        {
          "method": "GET",
          "path": "/orders/{{oid}}",
          "headers": {
            "Authorization": "Bearer {{btok}}"
          },
          "body": null,
          "capture": {}
        }
      ]
    },
    {
