      "title": "Non-admin fan can change event price and capacity via PATCH /events/{id}",
      "severity": "critical",
      "category": "security",
      "spec_rule": "\"### Update \u2014 PATCH /events/{id} (admin only) ... An authenticated caller who is not an admin gets 403 code forbidden.\"",
      "expected": "A fan token gets 403 with code \"forbidden\" and the event is unchanged.",
      "actual": "PATCH /events/11 with alice's (fan) token returns 200 and sets priceCents to 100.",
      "repro_steps": [
        {
          "method": "POST",
          "path": "/auth/login",
          "headers": {},
          "body": {
            "username": "alice",
            "password": "alice-pass"
          },
          "capture": {
            "tok": "token"
          }
        },
        {
          "method": "PATCH",
          "path": "/events/11",
          "headers": {
            "Authorization": "Bearer {{tok}}"
          },
          "body": {
            "priceCents": 100
          },
          "capture": {}
        },
        {
          "method": "GET",
          "path": "/events/11",
          "headers": {},
          "body": null,
          "capture": {}
        }
      ]
    },
